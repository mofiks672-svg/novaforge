// NovaForge — Windows resources: icon and version info shown in Explorer / Task Manager.
#include <winver.h>

#define NOVA_VER        1,5,1,0
#define NOVA_VER_STR    "1.5.1"

1 ICON "novaforge.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    NOVA_VER
 PRODUCTVERSION NOVA_VER
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName",      "NovaForge"
            VALUE "FileDescription",  "NovaForge - AI assistant for code in the terminal"
            VALUE "FileVersion",      NOVA_VER_STR
            VALUE "InternalName",     "nova"
            VALUE "LegalCopyright",   "(c) 2026 NovaForge. MIT License."
            VALUE "OriginalFilename", "nova.exe"
            VALUE "ProductName",      "NovaForge"
            VALUE "ProductVersion",   NOVA_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
